      "category": "Group",
      "fields": [
        { "name": "updater",  "type": "Address",              "isTopic": true,  "required": true },
        { "name": "category", "type": "NotificationCategory", "isTopic": true,  "required": true },
        { "name": "id",       "type": "BytesN<32>",           "isTopic": false, "required": true }
      ]
    },
    {
      "structName": "GroupDeactivated",
      "eventSymbol": "group_deactivated",
      "dataFormat": "single-value",
      "category": "Group",
      "fields": [
        { "name": "creator",  "type": "Address",              "isTopic": true,  "required": true },
        { "name": "category", "type": "NotificationCategory", "isTopic": true,  "required": true },
        { "name": "id",       "type": "BytesN<32>",           "isTopic": false, "required": true }
      ]
    },
    {
      "structName": "GroupActivated",
      "eventSymbol": "group_activated",
      "dataFormat": "single-value",
      "category": "Group",
      "fields": [
        { "name": "creator",  "type": "Address",              "isTopic": true,  "required": true },
        { "name": "category", "type": "NotificationCategory", "isTopic": true,  "required": true },
        { "name": "id",       "type": "BytesN<32>",           "isTopic": false, "required": true }
      ]
