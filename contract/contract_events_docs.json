      "fields": [
        { "name": "token",     "type": "Address",              "isTopic": true,  "required": true },
        { "name": "recipient", "type": "Address",              "isTopic": true,  "required": true },
        { "name": "category",  "type": "NotificationCategory", "isTopic": true,  "required": true },
        { "name": "amount",    "type": "i128",                 "isTopic": false, "required": true }
