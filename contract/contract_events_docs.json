        { "name": "old_admin", "type": "Address",              "isTopic": true,  "required": true },
        { "name": "category",  "type": "NotificationCategory", "isTopic": true,  "required": true },
        { "name": "new_admin", "type": "Address",              "isTopic": false, "required": true }
      ]
    },
    {
      "structName": "Withdrawal",
      "eventSymbol": "withdrawal",
      "dataFormat": "single-value",
